# Porta HTTP (no Render é definida automaticamente pela plataforma)
PORT=3000

# Conexão com o PostgreSQL
# Local:    DB_HOST=localhost, DB_USER=postgres, DB_SSL=false
# Supabase: use o "Session pooler" (Connect > Session pooler) e DB_SSL=true
#           DB_HOST=aws-0-<regiao>.pooler.supabase.com
#           DB_PORT=5432
#           DB_USER=postgres.<ref-do-projeto>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# true para o Supabase; false para PostgreSQL local
DB_SSL=false
